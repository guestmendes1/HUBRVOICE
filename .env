# ============================================
# HubBR Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# Database (PostgreSQL)
# ============================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/hubbr?schema=public"

# ============================================
# Google OAuth 2.0
# ============================================
# Get these from Google Cloud Console > APIs & Services > Credentials
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth redirect URI (update for production)
# Development:  http://localhost:3000/api/auth/callback/google
# Production:   https://your-domain.com/api/auth/callback/google
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ============================================
# NextAuth.js
# ============================================
# Base URL of your app (no trailing slash)
# Development:  http://localhost:3000
# Production:   https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Secret for JWT encryption — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change-me-to-a-random-secret

# ============================================
# App Config
# ============================================
NEXT_PUBLIC_APP_NAME=HubBR
NEXT_PUBLIC_APP_URL=http://localhost:3000
